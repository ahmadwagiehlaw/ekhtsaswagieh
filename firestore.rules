rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users_directory/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users_directory/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'ahmad.wagieh@gmail.com' 
        || (hasUserDoc() && getUserData().role == 'super_admin')
      );
    }

    function isConsultant() {
      return hasUserDoc() && getUserData().role == 'consultant';
    }

    function hasTenantAccess(tenantId) {
      return hasUserDoc() && getUserData().tenantId == tenantId;
    }

    // 1. Multi-Tenant Isolated Data
    match /tenants/{tenantId}/{document=**} {
      allow read, write: if hasTenantAccess(tenantId) || isSuperAdmin();
    }

    // 2. Users Directory
    match /users_directory/{userId} {
      allow read: if isSuperAdmin();
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow read: if hasUserDoc() && getUserData().tenantId == resource.data.tenantId;

      // Allow consultant/admin to create an employee entry for their own tenant
      allow create: if isSuperAdmin() || 
                   (isConsultant() 
                   && request.resource.data.tenantId == getUserData().tenantId
                   && request.resource.data.role == 'employee');

      // Allow new consultants to create their own entry (when signing up with an invite)
      allow create: if isAuthenticated() && request.auth.uid == userId
                   && request.resource.data.role == 'consultant'
                   && request.resource.data.inviteCode != null
                   && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode))
                   && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.tenantId == request.resource.data.tenantId
                   && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.used == false;

      // Allow updating own record (or super admin), but prevent updating role, tenantId, and inviteCode unless SuperAdmin
      allow update: if isSuperAdmin() || 
                   (isAuthenticated() && request.auth.uid == userId 
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'tenantId', 'inviteCode']));
    }

    // 3. Invites Collection
    match /invites/{code} {
      allow read: if true;
      allow create: if isSuperAdmin();
      allow update: if request.resource.data.used == true;
    }

    // 4. Legacy Roots (For Migration Script Only)
    match /appData/{document=**} {
      allow read, write: if isSuperAdmin();
    }
    match /cases/{document=**} {
      allow read, write: if isSuperAdmin();
    }
    match /rolls/{document=**} {
      allow read, write: if isSuperAdmin();
    }
    match /tasks/{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
